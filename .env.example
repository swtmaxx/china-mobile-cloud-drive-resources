# 139 credentials stay server-side. Never prefix these with VITE_.
YUN139_USERNAME=
YUN139_PASSWORD=
YUN139_MAIL_COOKIES=
YUN139_AUTHORIZATION=

# Cloudflare Pages/Workers secrets.
AUTH_ENCRYPTION_KEY=generate-a-32-byte-base64-key
RESOURCE_HANDLE_KEY=generate-a-32-byte-base64-key
ADMIN_PASSWORD=set-an-initial-admin-password
ADMIN_SESSION_KEY=generate-a-32-byte-base64-key
ADMIN_DATA_KEY=generate-a-32-byte-base64-key

# Set these in wrangler.toml or Pages environment variables.
YUN139_TYPE=personal_new
YUN139_ROOT_ID=/
RESOURCE_HANDLE_TTL=86400
RESOURCE_CACHE_TTL=60

# Optional Vite build-time site branding.
VITE_SITE_NAME=资源分发站
